{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicas": {
      "type": "integer",
      "const": 1,
      "description": "The replica count must be 1."
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "const": false,
          "description": "Autoscaling must be disabled."
        }
      }
    }
  }
}
